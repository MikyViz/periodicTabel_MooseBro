{
  "name": "periodic-table-ts",
  "version": "0.1.0",
  "description": "A modern, strictly-typed, zero-dependency periodic table library with rich sourced data, formula parsing, isotopes, and i18n.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./isotopes": {
      "types": "./dist/isotopes.d.ts",
      "import": "./dist/isotopes.js",
      "require": "./dist/isotopes.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build:data": "tsx scripts/build-data/generate.ts",
    "build": "npm run build:data && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:todos": "tsx scripts/check-todos.ts",
    "prepublishOnly": "npm run build && npm run check:todos"
  },
  "keywords": [
    "periodic-table",
    "chemistry",
    "elements",
    "isotopes",
    "typescript",
    "formula-parser",
    "molar-mass"
  ],
  "license": "MIT",
  "author": "MikyViz",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
